# Supabase client settings (existing application requirements)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Transactional email; keep the API key server-only
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Portfolio <notifications@example.com>"
PORTFOLIO_OWNER_EMAIL=owner@example.com
APP_URL=http://localhost:4000
# Production: set APP_URL=https://your-domain.example (exact HTTPS origin).

# Server-only public messaging rate limits: generate 32 random bytes as 64 hex characters.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Server-only CMS login window signing key: 32 random bytes as base64url.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CMS_SESSION_SECRET=
# Production: set vercel or cloudflare for the trusted deployment path.
# On Vercel, VERCEL=1 selects vercel when this is unset. Cloudflare mode requires
# an origin that cannot be reached directly. Development can leave this unset.
# RATE_LIMIT_PROXY_MODE=vercel
